{
  "rewrites": [
    { "source": "/ats/gh/:path*", "destination": "https://boards-api.greenhouse.io/:path*" },
    { "source": "/ats/ashby/:path*", "destination": "https://api.ashbyhq.com/:path*" },
    { "source": "/ats/wd/:path*", "destination": "/api/wd/:path*" },
    { "source": "/api/:path*", "destination": "https://globalyogas.com/api/:path*" },
    { "source": "/((?!ats/|api/).*)", "destination": "/index.html" }
  ]
}
